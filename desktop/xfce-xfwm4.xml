<?xml version="1.0" encoding="UTF-8"?>
<!-- XFCE xfwm4 窗口管理器默认配置 —— macOS WhiteSur
     主题：WhiteSur-Dark（含左上角红绿灯关闭/最小化/最大化按钮素材）
     按钮布局：CHM|（macOS：左上角 关闭-最小化-最大化，右侧空）
     标题字体：居中显示由 title_alignment=center 实现（macOS 标题居中）
     button_layout 语法：| 是左右分隔符，左侧字符显示在标题栏左、右侧字符显示在右。
     字符：H=Hide/最小化 M=Maximize C=Close O=Options 菜单 T=Sticky S=Shade。
     WhiteSur 素材左上角顺序为 close/hide/maximize，对应 CHM|。 -->
<channel name="xfwm4" version="1">
  <property name="general" type="empty">
    <property name="theme" type="string" value="WhiteSur-Dark"/>
    <property name="button_layout" type="string" value="CHM|"/>
    <!-- CHM| = 左上角依次 关闭(红) 最小化(黄) 最大化(绿)，对齐 macOS -->
    <property name="title_font" type="string" value="Sarasa UI SC SemiBold 9"/>
    <!-- 标题居中（macOS 窗口标题默认居中；XFCE 默认左对齐） -->
    <property name="title_alignment" type="string" value="center"/>
    <!-- 焦点跟随鼠标关闭（RDP 远程默认点击聚焦更符合习惯）-->
    <property name="click_to_focus" type="bool" value="true"/>
    <property name="focus_new" type="bool" value="true"/>
    <property name="raise_on_click" type="bool" value="true"/>
    <property name="raise_on_focus" type="bool" value="false"/>
    <!-- 捕获移动时实时显示（RDP 带宽 OK 时体验好）-->
    <property name="box_move" type="bool" value="false"/>
    <property name="box_resize" type="bool" value="false"/>
    <!-- 双击最大化（macOS 双击标题栏 zoom）-->
    <property name="double_click_action" type="string" value="maximize"/>
    <!-- 滚轮在标题栏上无动作，避免误操作 -->
    <property name="scroll_workspaces" type="bool" value="false"/>
    <property name="wrap_windows" type="bool" value="false"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
    <!-- 工作区数量 2（默认 4 太多，RDP 单屏一般够用）-->
    <property name="workspace_count" type="int" value="2"/>
    <property name="workspace_names" type="array">
      <value type="string" value="工作区 1"/>
      <value type="string" value="工作区 2"/>
    </property>
  </property>
</channel>
