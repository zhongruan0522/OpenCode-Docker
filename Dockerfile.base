# syntax=docker/dockerfile:1

# ==========================================
# 基础镜像：包含所有稳定、低频变动的组件
# 仅在手动修改本文件时才需要重建
# CI 推送到 ghcr.io/zhongruan0522/opencode-docker:base
# ==========================================

# ---
# 阶段 1.5：编译 MicroSOCKS 引擎
# ---
FROM alpine:latest AS microsocks-builder

RUN apk add --no-cache build-base git
RUN git clone https://github.com/rofl0r/microsocks.git /src && \
    cd /src && make CFLAGS="-static -O2" LDFLAGS="-static"

# ---
# 阶段 2：构建环境（完整工具链，产出所有制品）
# ---
FROM node:24.10.0-bookworm-slim AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG PLAYWRIGHT_MCP_VERSION=0.0.70
ARG WRANGLER_VERSION=latest
ARG EAS_CLI_VERSION=latest
ARG ELECTRON_VERSION=41.7.1
ARG BUN_VERSION=1.3.14
ARG PNPM_VERSION=10.33.2
ARG JS_REVERSE_MCP_VERSION=2.1.6
ARG ANYTHING_ANALYZER_VERSION=3.6.50
ARG RADARE2_VERSION=6.1.6
ARG FLUTTER_VERSION=3.44.4

ENV GOLANG_VERSION=1.26.4
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PLAYWRIGHT_BROWSERS_PATH=/home/app/.cache/ms-playwright \
    BUN_INSTALL=/opt/bun \
    GOPATH=/home/app/go
ENV PATH="/usr/local/go/bin:/home/app/go/bin:/opt/bun/bin:/opt/flutter/bin:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${PATH}"

# 系统依赖（含 build-essential，构建完就扔）
# Adoptium (Eclipse Temurin) 仓库 — Debian bookworm 默认仓库不提供 JDK 21
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        curl \
        gnupg \
        jq \
        git \
        bash \
        gosu \
        supervisor \
        openssh-client \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        openjdk-17-jdk-headless \
        temurin-21-jdk \
        vim \
        wget \
        unzip \
        xz-utils \
        nano \
        tmux \
        ripgrep \
        sqlite3 \
        libsqlite3-dev \
        python-is-python3 \
        poppler-utils \
        fonts-noto-cjk \
        bubblewrap \
        wireguard-tools \
        iptables \
        iproute2 \
        kmod \
    && sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# Go + Bun + pnpm
RUN curl -fsSL https://go.dev/dl/go${GOLANG_VERSION}.linux-$(dpkg --print-architecture).tar.gz | tar -C /usr/local -xzf - \
    && curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
    && ln -sf /opt/bun/bin/bun /usr/local/bin/bun \
    && ln -sf /opt/bun/bin/bunx /usr/local/bin/bunx \
    && rm -rf /usr/local/go/test /usr/local/go/doc /usr/local/go/misc /usr/local/go/api \
    && npm install -g pnpm@${PNPM_VERSION}

# gopls (Go 语言服务器)
RUN mkdir -p "${GOPATH}" \
    && GOBIN=/usr/local/bin go install golang.org/x/tools/gopls@latest

# govulncheck (Go 漏洞扫描工具)
RUN GOBIN=/usr/local/bin go install golang.org/x/vuln/cmd/govulncheck@latest

# Rust 工具链（codex-rs 工作区需要）
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.95.0 --profile minimal \
    && rustup component add clippy rustfmt rust-src \
    && rustup toolchain install nightly-2025-09-18 --profile minimal --component llvm-tools-preview --component rustc-dev --component rust-src \
    && rm -rf "${RUSTUP_HOME}"/toolchains/*/share/doc \
              "${RUSTUP_HOME}"/toolchains/*/share/man

# Android SDK
RUN mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools" \
    && curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" -o /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools \
    && mv /tmp/cmdline-tools/cmdline-tools "${ANDROID_SDK_ROOT}/cmdline-tools/latest" \
    && rm -rf /tmp/cmdline-tools.zip /tmp/cmdline-tools \
    && yes | sdkmanager --licenses > /dev/null 2>&1 \
    && sdkmanager --install \
        "build-tools;35.0.1" \
        "build-tools;30.0.2" \
        "platform-tools" \
        "platforms;android-36" \
        "platforms;android-35" \
        "platforms;android-34" \
        "platforms;android-30" \
    && ln -sf "${ANDROID_SDK_ROOT}/build-tools/35.0.1/apksigner" /usr/local/bin/apksigner \
    && ln -sf "${ANDROID_SDK_ROOT}/build-tools/35.0.1/zipalign" /usr/local/bin/zipalign \
    && rm -rf "${ANDROID_SDK_ROOT}/.temp"

# Flutter SDK（依赖上面的 Android SDK、JDK、Gradle）
# Flutter tarball 本身是 git 仓库，构建阶段以 root 运行 flutter 预热时，
# git 会因目录所有权触发 dubious ownership 报错，需配置 safe.directory。
# builder 阶段无 app 用户，目录归属在最终阶段 COPY --chown=app:app 时统一设置。
RUN curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
        -o /tmp/flutter.tar.xz \
    && tar -xf /tmp/flutter.tar.xz -C /opt \
    && rm -f /tmp/flutter.tar.xz \
    && git config --global --add safe.directory /opt/flutter \
    && /opt/flutter/bin/flutter --version

# Gradle 7.5 + 9.0
ENV GRADLE_HOME=/opt/gradle
RUN curl -fsSL "https://services.gradle.org/distributions/gradle-7.5-bin.zip" -o /tmp/gradle-7.5.zip \
    && unzip -q /tmp/gradle-7.5.zip -d /opt \
    && curl -fsSL "https://services.gradle.org/distributions/gradle-9.0-bin.zip" -o /tmp/gradle-9.0.zip \
    && unzip -q /tmp/gradle-9.0.zip -d /opt \
    && ln -sf /opt/gradle-9.0.0/bin/gradle /usr/local/bin/gradle \
    && rm -f /tmp/gradle-7.5.zip /tmp/gradle-9.0.zip

# microsocks
COPY --from=microsocks-builder /src/microsocks /usr/local/bin/microsocks

# gh CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Playwright MCP（仅安装 npm 包，浏览器在下面单独装）
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g @playwright/mcp@${PLAYWRIGHT_MCP_VERSION} \
    && npm install -g js-reverse-mcp@${JS_REVERSE_MCP_VERSION} \
    && npm install -g @larksuite/cli \
    && npm install -g wrangler@${WRANGLER_VERSION} \
    && npm install -g eas-cli@${EAS_CLI_VERSION}

# 高频全局 npm 工具（出现在 3+ 项目）
# @vscode/vsce：cursor-zh-cn-pack 打包 .vsix 用（npm run package / release:build）
RUN npm install -g typescript eslint prettier esbuild tsx turbo oxlint vitest @vscode/vsce

# yarn（UnifyNook web 声明 packageManager: yarn@1.22.22）
# Node.js 24 镜像已内置 corepack 和 yarn shim，npm install -g 会 EEXIST 冲突。
# 用 corepack prepare 固定 yarn 1.22.22 版本即可。
RUN corepack enable && corepack prepare yarn@1.22.22 --activate

# 办公四件套 Node.js 依赖（pptx/pdf skills）
RUN npm install -g pptxgenjs prismjs mathjax-full skia-canvas pdf-lib pdfjs-dist

# Wine（Linux 上交叉编译 Windows NSIS 安装包所需）
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        wine \
        wine64 \
        wine32 \
        mono-complete \
        nsis \
    && rm -rf /var/lib/apt/lists/*

# Windows Electron 二进制缓存（Linux 上交叉编译 Windows 桌面包所需）
# electron-builder 打 Windows 包时需要 win32 平台的 electron.exe，
# 而 npm install 只会下载当前平台（linux）的二进制。
ARG ELECTRON_VERSION
RUN mkdir -p /opt/electron-cache/win32-x64 \
    && curl -fSL --retry 3 "https://github.com/electron/electron/releases/download/v${ELECTRON_VERSION}/electron-v${ELECTRON_VERSION}-win32-x64.zip" \
       -o /tmp/electron-win32-x64.zip \
    && unzip -q /tmp/electron-win32-x64.zip -d /opt/electron-cache/win32-x64 \
    && rm -f /tmp/electron-win32-x64.zip \
    && touch /opt/electron-cache/win32-x64/.version-${ELECTRON_VERSION}

# APK 反编译工具链（apktool / jadx / dex2jar / uber-apk-signer）
# Java 17 已在上面安装，所有工具基于 jar 运行
ARG APKTOOL_VERSION=3.0.2
ARG JADX_VERSION=1.5.5
ARG DEX2JAR_VERSION=2.4.35
ARG UBER_APK_SIGNER_VERSION=1.3.0
RUN mkdir -p /opt/apk-tools/bin \
    # apktool — 反编译/重打包 APK 资源和 smali
    && curl -fsSL "https://github.com/iBotPeaches/Apktool/releases/download/v${APKTOOL_VERSION}/apktool_${APKTOOL_VERSION}.jar" \
       -o /opt/apk-tools/apktool.jar \
    # jadx — dex 反编译为 Java 源码（zip 解压后 bin/ 下已有 jadx / jadx-gui 启动脚本）
    && curl -fsSL "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip" \
       -o /tmp/jadx.zip \
    && unzip -q /tmp/jadx.zip -d /opt/apk-tools/jadx \
    && rm -f /tmp/jadx.zip \
    # dex2jar — dex 与 jar 互转
    # 解压后根目录含 d2j-*.sh（不在 bin/ 下），lib/ 也同层，脚本靠 dirname 自身路径定位 lib
    && curl -fsSL "https://github.com/ThexXTURBOXx/dex2jar/releases/download/${DEX2JAR_VERSION}/dex-tools-${DEX2JAR_VERSION}.zip" \
       -o /tmp/dex-tools.zip \
    && unzip -q /tmp/dex-tools.zip -d /tmp/dex-tools \
    && mv /tmp/dex-tools/dex-tools-* /opt/apk-tools/dex2jar \
    && rm -rf /tmp/dex-tools /tmp/dex-tools.zip \
    # uber-apk-signer — APK 签名/zipalign/校验
    && curl -fsSL "https://github.com/patrickfav/uber-apk-signer/releases/download/v${UBER_APK_SIGNER_VERSION}/uber-apk-signer-${UBER_APK_SIGNER_VERSION}.jar" \
       -o /opt/apk-tools/uber-apk-signer.jar \
    # 创建 wrapper 脚本，使命令行可直接调用
    # apktool / uber-apk-signer：jar 入口，直接 java -jar
    && printf '#!/usr/bin/env bash\nexec java -jar /opt/apk-tools/apktool.jar "$@"\n' > /opt/apk-tools/bin/apktool \
    && printf '#!/usr/bin/env bash\nexec java -jar /opt/apk-tools/uber-apk-signer.jar "$@"\n' > /opt/apk-tools/bin/uber-apk-signer \
    # dex2jar：d2j-*.sh 用 dirname 自身路径定位 lib，绝对路径调用即可，不要 cd（否则破坏用户相对路径）
    && printf '#!/usr/bin/env bash\nexec /opt/apk-tools/dex2jar/d2j-dex2jar.sh "$@"\n' > /opt/apk-tools/bin/d2j-dex2jar \
    && printf '#!/usr/bin/env bash\nexec /opt/apk-tools/dex2jar/d2j-baksmali.sh "$@"\n' > /opt/apk-tools/bin/d2j-baksmali \
    && printf '#!/usr/bin/env bash\nexec /opt/apk-tools/dex2jar/d2j-asm-verify.sh "$@"\n' > /opt/apk-tools/bin/d2j-asm-verify \
    && chmod +x /opt/apk-tools/bin/* \
    && chmod +x /opt/apk-tools/jadx/bin/jadx /opt/apk-tools/jadx/bin/jadx-gui \
    && chmod +x /opt/apk-tools/dex2jar/d2j-*.sh

# 逆向 GUI / CLI 工具链（radare2 / Anything Analyzer）
# radare2 用官方 deb 包（命名规律 radare2_<ver>_<arch>.deb，arch 与 dpkg 一致），apt 自动解决依赖
# Anything Analyzer 是单一 AppImage（文件名不带架构标识）
RUN set -eux; \
    r2_arch="$(dpkg --print-architecture)"; \
    case "${r2_arch}" in amd64|arm64) ;; *) echo "Unsupported radare2 architecture: ${r2_arch}" >&2; exit 1 ;; esac; \
    curl -fsSL "https://github.com/radareorg/radare2/releases/download/${RADARE2_VERSION}/radare2_${RADARE2_VERSION}_${r2_arch}.deb" -o /tmp/radare2.deb; \
    apt-get update && apt-get install -y --no-install-recommends /tmp/radare2.deb && rm -rf /var/lib/apt/lists/*; \
    rm -f /tmp/radare2.deb; \
    mkdir -p /opt/anything-analyzer; \
    curl -fL --retry 5 --retry-all-errors --connect-timeout 30 --max-time 900 \
      "https://github.com/Mouseww/anything-analyzer/releases/download/v${ANYTHING_ANALYZER_VERSION#v}/Anything-Analyzer-${ANYTHING_ANALYZER_VERSION}.AppImage" \
      -o /opt/anything-analyzer/anything-analyzer.AppImage; \
    chmod +x /opt/anything-analyzer/anything-analyzer.AppImage; \
    printf '#!/usr/bin/env bash\nexec /opt/anything-analyzer/anything-analyzer.AppImage --no-sandbox "$@"\n' > /usr/local/bin/anything-analyzer; \
    chmod +x /usr/local/bin/anything-analyzer

# uv (Python 包管理器)
RUN curl -fsSL https://astral.sh/uv/install.sh | env CARGO_HOME=/opt/uv UV_INSTALL_DIR=/usr/local/bin sh \
    && rm -rf /opt/uv

# Python 包
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        Pillow \
        "scrapling[all]>=0.4.2" \
        # 办公四件套依赖（docx/xlsx/pptx/pdf skills）
        openpyxl \
        pdf2image \
        pypdf \
        PyMuPDF \
        pdfplumber \
        reportlab \
        python-docx \
        python-pptx \
        defusedxml \
        numpy \
        PyYAML \
        # HTTP 客户端（项目运行时依赖）
        httpx \
        requests \
        charset-normalizer \
        "chardet>=5.2.0,<6" \
        # 安全测试工具链运行时依赖
        arjun \
        uro \
        bloodhound \
        impacket \
        mcp \
        frida-tools \
        # Z3r0 红队协作工作台运行时依赖
        # Web 框架栈
        fastapi \
        "uvicorn[standard]" \
        python-multipart \
        sse-starlette \
        websockets \
        # 数据库（PostgreSQL 异步驱动 + ORM）
        SQLAlchemy \
        sqlmodel \
        asyncpg \
        # 数据校验与配置
        pydantic \
        pydantic-settings \
        # OpenAI / 多智能体运行时
        openai \
        openai-agents \
        tiktoken \
        # 沙箱与远程执行（SSH + Docker SDK）
        asyncssh \
        docker \
        # 通用工具
        PyJWT \
        python-dotenv \
        jsonschema \
        httpx-sse \
        click \
        tqdm

# Playwright Chromium 浏览器（体积大头，单独一层）
RUN mkdir -p "${PLAYWRIGHT_BROWSERS_PATH}" \
    && PLAYWRIGHT_ROOT="$(npm root -g)" \
    && if [ -f "${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright/cli.js" ]; then \
         PLAYWRIGHT_CLI="${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright/cli.js"; \
       elif [ -f "${PLAYWRIGHT_ROOT}/playwright/cli.js" ]; then \
         PLAYWRIGHT_CLI="${PLAYWRIGHT_ROOT}/playwright/cli.js"; \
       elif [ -f "${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright-core/cli.js" ]; then \
         PLAYWRIGHT_CLI="${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright-core/cli.js"; \
       else \
         echo "Playwright CLI not found in ${PLAYWRIGHT_ROOT}" >&2; \
         exit 1; \
       fi \
    && PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH}" node "${PLAYWRIGHT_CLI}" install-deps chromium \
    && PLAYWRIGHT_INSTALL_PLAN="$(PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH}" node "${PLAYWRIGHT_CLI}" install --dry-run chromium)" \
    && printf '%s\n' "${PLAYWRIGHT_INSTALL_PLAN}" \
    && extract_plan_field() { \
         artifact="$1"; \
         field="$2"; \
         printf '%s\n' "${PLAYWRIGHT_INSTALL_PLAN}" | awk -v artifact="${artifact}" -v field="${field}" '\
           $0 ~ "^" artifact " " { in_block=1; next } \
           /^[^[:space:]]/ && in_block { in_block=0 } \
           in_block && index($0, field ":") { print $3; exit }'; \
       } \
    && install_archive() { \
         name="$1"; \
         install_dir="$2"; \
         download_url="$3"; \
         if [ -z "${install_dir}" ] || [ -z "${download_url}" ]; then \
           echo "Missing Playwright install data for ${name}" >&2; \
           exit 1; \
         fi; \
         tmp_zip="/tmp/playwright-${name}.zip"; \
         rm -rf "${install_dir}" "${tmp_zip}"; \
         mkdir -p "${install_dir}"; \
         echo "Downloading ${name} from ${download_url}"; \
         curl -fL --retry 5 --retry-all-errors --connect-timeout 30 --max-time 900 "${download_url}" -o "${tmp_zip}"; \
         unzip -q "${tmp_zip}" -d "${install_dir}"; \
         rm -f "${tmp_zip}"; \
         touch "${install_dir}/INSTALLATION_COMPLETE" "${install_dir}/DEPENDENCIES_VALIDATED"; \
       } \
    && install_archive chromium "$(extract_plan_field 'Chrome for Testing' 'Install location')" "$(extract_plan_field 'Chrome for Testing' 'Download url')" \
    && install_archive ffmpeg "$(extract_plan_field 'FFmpeg' 'Install location')" "$(extract_plan_field 'FFmpeg' 'Download url')" \
    && install_archive chromium-headless-shell "$(extract_plan_field 'Chrome Headless Shell' 'Install location')" "$(extract_plan_field 'Chrome Headless Shell' 'Download url')" \
    && PYTHON_PW_REVISION=$(python3 -m playwright install --dry-run chromium 2>&1 | grep -oP 'chromium v\K[0-9]+') \
    && NODE_REVISION=$(ls -d "${PLAYWRIGHT_BROWSERS_PATH}/chromium-"* | grep -oP 'chromium-\K[0-9]+' | sort -rn | head -1) \
    && if [ "${PYTHON_PW_REVISION}" != "${NODE_REVISION}" ]; then \
         echo "Symlinking chromium-${PYTHON_PW_REVISION} -> chromium-${NODE_REVISION} for Python playwright"; \
         ln -sf "${PLAYWRIGHT_BROWSERS_PATH}/chromium-${NODE_REVISION}" "${PLAYWRIGHT_BROWSERS_PATH}/chromium-${PYTHON_PW_REVISION}"; \
         if [ -d "${PLAYWRIGHT_BROWSERS_PATH}/chromium_headless_shell-${NODE_REVISION}" ]; then \
           ln -sf "${PLAYWRIGHT_BROWSERS_PATH}/chromium_headless_shell-${NODE_REVISION}" "${PLAYWRIGHT_BROWSERS_PATH}/chromium_headless_shell-${PYTHON_PW_REVISION}"; \
         fi; \
       else \
         echo "Revisions match (${NODE_REVISION}), no symlink needed"; \
       fi \
    && PLAYWRIGHT_SKIP_BROWSER_GC=1 scrapling install --force

# ---
# 阶段 3：最终基础镜像（无编译工具链，从 builder 拷成品）
# ---
FROM node:24.10.0-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
USER root
WORKDIR /app

# 解除 node:*-slim 基础镜像的 dpkg path-exclude 规则对 /usr/share/locale/* 的剔除。
# 该规则由 debian slim 镜像注入（/etc/dpkg/dpkg.cfg.d/docker），会在 apt 安装阶段
# 直接丢弃所有 .mo 翻译文件，导致即使 LANG=zh_CN.UTF-8 且 xfce4-* 包自带 zh_CN 翻译，
# 实际文件系统里也没有任何翻译可用——XFCE 桌面、whisker 菜单、xfwm4、thunar、terminal
# 全部强制显示英文，外部表现就是"装了汉化包但实际全英文"。
# 这里删除该 dpkg 配置文件中所有 path-exclude /usr/share/locale/* 行，
# 让后续 apt install xfce4-* 时翻译文件能正常落盘。
# 同时保留 /usr/share/doc 和 /usr/share/man 的精简（不删，对汉化无关）。
RUN sed -i '/^path-exclude \/usr\/share\/locale\/\*$/d' /etc/dpkg/dpkg.cfg.d/docker \
    && if grep -qE '^path-exclude.*/usr/share/locale' /etc/dpkg/dpkg.cfg.d/docker; then \
         echo "FATAL: /usr/share/locale path-exclude still present after sed" >&2; \
         exit 1; \
       else \
         echo "OK: /usr/share/locale path-exclude removed, translations will be installed"; \
       fi

# 运行时依赖 + Playwright Chromium 系统库 + Wine（Windows 交叉编译）
# 启用 non-free 组件，因为 unrar 仅在 non-free 仓库中提供
# Adoptium (Eclipse Temurin) 仓库 — Debian bookworm 默认仓库不提供 JDK 21
RUN dpkg --add-architecture i386 \
    && sed -i 's/Components: main/Components: main non-free non-free-firmware/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        curl \
        gnupg \
        git \
        bash \
        gosu \
        supervisor \
        sudo \
        openssh-client \
        openssh-server \
        python3 \
        python3-pip \
        python3-venv \
        tini \
        vim \
        wget \
        unzip \
        nano \
        tmux \
        ripgrep \
        sqlite3 \
        libsqlite3-dev \
        python-is-python3 \
        poppler-utils \
        fonts-noto-cjk \
        bubblewrap \
        wireguard-tools \
        iptables \
        iproute2 \
        kmod \
        gcc \
        g++ \
        make \
        cmake \
        pkg-config \
        libssl-dev \
        # 常用网络/系统诊断工具
        lsof \
        net-tools \
        procps \
        dnsutils \
        netcat-openbsd \
        strace \
        htop \
        tree \
        file \
        less \
        jq \
        # 压缩/解压工具（zip/gz/7z/bzip2/zstd/rar）
        zip \
        unzip \
        gzip \
        bzip2 \
        xz-utils \
        zstd \
        p7zip-full \
        unrar \
        # 文件同步工具
        rsync \
        openjdk-17-jdk-headless \
        temurin-21-jdk \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libgbm1 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libasound2 \
        libatspi2.0-0 \
        libpango-1.0-0 \
        libcairo2 \
        libdbus-1-3 \
        # Electron/AppImage GUI 运行时依赖（Anything Analyzer）
        libfuse2 \
        libgtk-3-0 \
        libsecret-1-0 \
        libxss1 \
        libxtst6 \
        libxshmfence1 \
        xdg-utils \
        # 办公四件套运行时依赖（docx/xlsx/pptx/pdf skills）
        libreoffice-calc \
        libreoffice-writer \
        libreoffice-impress \
        libreoffice-draw \
        libreoffice-common \
        inkscape \
        imagemagick \
        ghostscript \
        libheif-examples \
        # 文档格式转换工具（Markdown / HTML / docx 等互转）
        pandoc \
        # Wine + NSIS（Linux 上交叉编译 Windows 安装包）
        wine \
        wine64 \
        wine32 \
        mono-complete \
        nsis \
        # 远程桌面 (xrdp + XFCE4)
        # XFCE4 是 GTK 实现的成熟轻量桌面环境，对 xrdp 容器场景支持最好
        # （linuxserver/webtop、dorowu/ubuntu-desktop 等都选用 XFCE）
        # 不用 LXQt 的原因：lxqt-panel 在无系统 D-Bus 容器里首次生成的 panel.conf
        # 颜色会被错误序列化为 @Variant(...\\x00*6) 即 RGB(0,0,0)，导致黑底黑字隐形
        # xrdp/xorgxrdp 提供 RDP 协议接入，xfwm4 是 XFCE 默认窗口管理器
        # dbus-x11 + dbus + policykit-1：补齐系统总线，让 polkit/udisks2 正常工作
        # fcitx5 + fcitx5-chinese-addons + gtk3 前端提供中文输入法（XFCE 走 GTK）
        # papirus-icon-theme：保留作为兜底图标（Fluent 主题上游失效时降级显示）
        # fonts-sarasa-gothic：更纱 Gothic，中英文等宽对齐，1cjk=2ascii，终端/编辑器友好
        # xfce4-notifyd：Fluent 圆角通知需要的通知守护，否则 fcitx5 切换提示丑陋
        xrdp \
        xorgxrdp \
        xfce4 \
        xfce4-terminal \
        xfce4-whiskermenu-plugin \
        xfce4-clipman-plugin \
        xfce4-screenshooter \
        xfce4-notifyd \
        thunar \
        dbus \
        dbus-x11 \
        policykit-1 \
        fcitx5 \
        fcitx5-frontend-gtk3 \
        fcitx5-chinese-addons \
        papirus-icon-theme \
    && usermod -aG ssl-cert xrdp \
    && sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# Google Chrome Stable（日常浏览用，与 Playwright bundled Chromium 分离）
# 同时被 Playwright MCP 通过 channel="chrome" 复用（见 entrypoint.sh: PLAYWRIGHT_MCP_BROWSER=chrome）。
# Playwright bundled Chromium 仍保留，供 Python playwright 及回归测试用。
# 必须装在最终镜像阶段：Chrome 是完整 apt 包（/usr/bin/google-chrome + /opt/google/chrome + 桌面图标），
# 不能像 gh CLI 那样靠单二进制 COPY --from=builder 搬运。
RUN curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && chmod go+r /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" | tee /etc/apt/sources.list.d/google-chrome.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# Sarasa Gothic 更纱字体（中英文等宽对齐的现代中文字体）
# Debian bookworm 仓库版本较旧且只有部分子集，这里直接从 GitHub releases 取最新固定版本。
# 字体覆盖：Sarasa UI/Mono/Term + 简中（SC），终端、UI、文档全场景适用。
# 单独成层便于版本升级，约 +60MB。
ARG SARASA_VERSION=1.0.26
RUN SARASA_ARCH="$(dpkg --print-architecture)" \
    && case "${SARASA_ARCH}" in amd64|arm64) ;; *) echo "Unsupported sarasa arch: ${SARASA_ARCH}" >&2; exit 1 ;; esac \
    && mkdir -p /usr/share/fonts/truetype/sarasa /tmp/sarasa \
    && curl -fsSL "https://github.com/be5invis/Sarasa-Gothic/releases/download/v${SARASA_VERSION}/Sarasa-TTF-${SARASA_VERSION}.7z" -o /tmp/sarasa/sarasa.7z \
    && 7z x -y /tmp/sarasa/sarasa.7z -o/tmp/sarasa >/dev/null \
    # 只保留 SC（简体）子集，避免装全 11 个 cjk 变体撑爆层（200MB+）
    && mv /tmp/sarasa/Sarasa*SC*.ttf /usr/share/fonts/truetype/sarasa/ \
    # 校验：若没装上任何字体，立刻失败而非静默通过
    && if [ -z "$(ls /usr/share/fonts/truetype/sarasa/*.ttf 2>/dev/null)" ]; then \
         echo "FATAL: no Sarasa SC ttf installed; release asset layout may have changed" >&2; \
         exit 1; \
       fi \
    && rm -rf /tmp/sarasa \
    && fc-cache -f /usr/share/fonts/truetype/sarasa \
    && echo "==> Sarasa 字体已安装: $(ls /usr/share/fonts/truetype/sarasa/ | wc -l) files"

# Fluent GTK 主题（vinceliuice/Fluent-gtk-theme，Win11 风格）
# 参考项目 tiny_container 默认主题。包含深浅色变体、xfwm4 窗口边框、GTK3/GTK4 资源。
# 仓库无 release tag，按 commit 拉取（约 +30MB）。
RUN git clone --depth 1 https://github.com/vinceliuice/Fluent-gtk-theme.git /tmp/fluent-gtk \
    && cd /tmp/fluent-gtk \
    # 安装到 /usr/share/themes（系统级），-t all 安装所有 accent 变体
    && bash install.sh -t all -d /usr/share/themes \
    # 校验核心主题目录确实生成（Fluent-Dark 是 xfwm4.xml 引用的主题名）
    && if [ ! -d /usr/share/themes/Fluent-Dark ]; then \
         echo "FATAL: /usr/share/themes/Fluent-Dark missing; install.sh layout may have changed" >&2; \
         ls /usr/share/themes/ | head -20 >&2; \
         exit 1; \
       fi \
    && rm -rf /tmp/fluent-gtk \
    && echo "==> Fluent GTK 主题已安装"

# Fluent 图标主题（vinceliuice/Fluent-icon-theme，与 GTK 主题配套）
# 含深浅色圆角图标，约 +100MB。
RUN git clone --depth 1 https://github.com/vinceliuice/Fluent-icon-theme.git /tmp/fluent-icon \
    && cd /tmp/fluent-icon \
    && bash install.sh -d /usr/share/icons \
    # 校验图标主题索引确实生成
    && if [ ! -f /usr/share/icons/Fluent/index.theme ]; then \
         echo "FATAL: /usr/share/icons/Fluent/index.theme missing" >&2; \
         ls /usr/share/icons/ | head -20 >&2; \
         exit 1; \
       fi \
    && rm -rf /tmp/fluent-icon \
    && echo "==> Fluent 图标主题已安装"

# Docker CE（DinD 模式）
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce docker-ce-cli docker-buildx-plugin docker-compose-plugin iptables \
    && rm -rf /var/lib/apt/lists/*

# xrdp 配置
# - xrdp.ini: 端口改为 3390（避免与宿主机 RDP 默认 3389 冲突），
#             降低 crypt_level 到 client 兼容更多客户端，禁用 bitmap_cache 减少内存占用，
#             登录窗口背景色对齐 Fluent 主题（ls_top_window_bg_color=0067c0）
# - startwm.sh: 启动 dbus 会话总线 + fcitx5 中文输入法 + XFCE4 会话
#   通过 COPY docker/xrdp-startwm.sh 注入（见文件末尾 COPY 块）
# - xsettings.xml: GTK/图标主题设为 Fluent，字体设为 Sarasa UI SC
# - xfwm4.xml: 窗口管理器主题设为 Fluent-Dark，按钮布局对齐 Win11
# - xfce-desktop.xml: 默认壁纸设为 Fluent 配色 SVG
#   三个 xfconf 文件均通过文件末尾 COPY 块注入
# 参考：https://github.com/neutrinolabs/xrdp/discussions/2309（容器内无 systemd 时需手动启动 xrdp）
# 注意：不要在 RUN 里用 `cmd1 && cmd2 <<EOF ... EOF` 这种"复合命令 + shell heredoc"形式，
#       BuildKit 的 Dockerfile 解析器会把 heredoc 后续行当成新 Dockerfile 指令报
#       "unknown instruction"。大段配置文件统一通过 COPY docker/ 注入。
RUN sed -i \
    -e 's/^port=3389/port=3390/' \
    -e 's/^max_bpp=32/max_bpp=24/' \
    -e 's/^crypt_level=high/crypt_level=client/' \
    -e 's/^bitmap_cache=true/bitmap_cache=false/' \
    -e 's/^#\?tcp_send_buffer_bytes=.*/tcp_send_buffer_bytes=4194304/' \
    /etc/xrdp/xrdp.ini \
    # 登录窗口配色对齐 Fluent 主题（深色 #0067c0 / accent #198ee6），
    # 默认 xrdp 是 90 年代蓝（#000000 顶 + #003366 横条），与 Fluent 桌面割裂。
    # 值来源：xrdp wiki Login Authentication Window 章节配置项。
    && sed -i \
        -e 's/^#\?ls_top_window_bg_color=.*/ls_top_window_bg_color=0067c0/' \
        -e 's/^#\?ls_bg_color=.*/ls_bg_color=f0f4f9/' \
        -e 's/^#\?ls_logo_filename=.*/ls_logo_filename=/' \
        /etc/xrdp/xrdp.ini \
    && echo "==> xrdp 登录界面配色已对齐 Fluent"

# 创建架构无关的 JAVA_HOME 符号链接（JDK 17 + JDK 21 共存，默认 21）
# UnifyNook Android 要求 sourceCompatibility VERSION_21，默认指向 JDK 21
# JDK 17 符号链接保留，旧项目可 export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-current 切换
# JDK 21 来自 Adoptium Temurin（Debian bookworm 默认仓库不提供 OpenJDK 21）
RUN JAVA_17_HOME="$(ls -d /usr/lib/jvm/java-17-openjdk-* | head -1)" \
    && JAVA_21_HOME="$(ls -d /usr/lib/jvm/temurin-21-* | head -1)" \
    && ln -sf "${JAVA_17_HOME}" /usr/lib/jvm/java-17-openjdk-current \
    && ln -sf "${JAVA_21_HOME}" /usr/lib/jvm/java-21-openjdk-current

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-current \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_HOME=/opt/android-sdk \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    GRADLE_HOME=/opt/gradle-9.0.0

ENV PNPM_HOME="/home/app/.local/share/pnpm" \
    PATH="/usr/local/go/bin:/home/app/go/bin:/opt/bun/bin:/opt/cargo/bin:/opt/flutter/bin:/opt/gradle-9.0.0/bin:/opt/gradle-7.5/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/35.0.1:/opt/apk-tools/bin:/opt/apk-tools/jadx/bin:/opt/apk-tools/dex2jar:/usr/lib/jvm/java-21-openjdk-current/bin:/home/app/.local/share/pnpm:${PATH}" \
    GOPATH="/home/app/go" \
    BUN_INSTALL="/opt/bun" \
    PLAYWRIGHT_BROWSERS_PATH=/home/app/.cache/ms-playwright \
    PLAYWRIGHT_MCP_HEADLESS=1 \
    PLAYWRIGHT_MCP_BROWSER=chrome \
    PLAYWRIGHT_MCP_SANDBOX=0 \
    WARP_SOCKS_PORT=1080 \
    ELECTRON_CACHE=/opt/electron-cache \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8 \
    EDITOR=vim \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HOME=/home/app

# 用户和目录
# /workspace 同时让 app 组可读写执行（desktop 已加入 app 组），保证两个用户都能访问代码工作区。
# 组写权限通过 chmod g+rwx + setgid 实现：setgid 让 /workspace 下新建子目录继承组而非创建者主组。
RUN if ! id -u app >/dev/null 2>&1; then useradd --create-home --shell /bin/bash --uid 10001 app; fi \
    && mkdir -p /workspace /home/app/.config/opencode /home/app/.config/code-server \
               /home/app/.cache /home/app/.local/share/code-server /etc/wireguard \
               "${PNPM_HOME}" /home/app/go \
    && chown -R app:app /home/app /workspace \
    && chmod g+rwx /workspace && chmod g+s /workspace

# desktop 用户（独立日常账号，可 sudo），作为推荐 RDP 登录账号
# 必须在 app 用户/组创建之后执行：usermod -aG app desktop 依赖 app 组已存在。
# 密码在 entrypoint.sh 运行时由 DESKTOP_USER_PASSWORD/DESKTOP_PASSWORD 注入，这里仅建账户。
# uid=10002 固定，entrypoint 的 LOCAL_UID 调整逻辑只针对 app，不会动 desktop，保证桌面登录始终是普通权限。
RUN useradd --create-home --shell /bin/bash --uid 10002 desktop \
    && usermod -aG app desktop \
    && echo 'desktop ALL=(ALL:ALL) ALL' > /etc/sudoers.d/desktop \
    && chmod 440 /etc/sudoers.d/desktop

# 从 builder 复制所有构建产物，较大的 app 可写目录在 COPY 阶段直接设置 ownership，避免后续递归 chown 生成额外大层。
COPY --from=builder /usr/local /usr/local
COPY --from=builder --chown=app:app /opt /opt
COPY --from=builder /usr/bin/gh /usr/bin/gh
COPY --from=builder --chown=app:app /home/app/.cache/ms-playwright /home/app/.cache/ms-playwright
COPY --from=builder --chown=app:app /home/app/go/pkg/mod /home/app/go/pkg/mod

# 预热 Go 模块缓存，避免容器启动后反复下载大体量依赖。
COPY base/go/preload-go-modules.sh /tmp/preload-go-modules.sh
RUN bash /tmp/preload-go-modules.sh \
    && chown -R app:app /home/app/go \
    && rm -f /tmp/preload-go-modules.sh

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/healthcheck.sh /usr/local/bin/healthcheck.sh
COPY docker/supervisord.conf /etc/supervisor/supervisord.conf
COPY base/microwarp/init-warp.sh /usr/local/bin/init-warp.sh
COPY docker/desktop/init-desktop.sh /usr/local/bin/init-desktop.sh
COPY docker/desktop/opencode-*.desktop /usr/local/share/opencode-desktop-launchers/
COPY docker/desktop/opencode-*.desktop /usr/share/applications/
# xrdp + XFCE4 启动脚本和默认配置（不走 RUN heredoc 是为了避免 BuildKit
# 解析器把"复合命令 + shell heredoc"中的 heredoc 内容误判为 Dockerfile 指令）
COPY docker/xrdp-startwm.sh /etc/xrdp/startwm.sh
# Fluent 桌面默认配置：
# - xfce-xsettings.xml：GTK 主题、图标主题、字体、Hinting、AntiAlias
# - xfce-desktop.xml：默认壁纸路径
# - xfwm4.xml：窗口管理器主题、标题按钮布局
# - xfce4-panel.xml：任务栏位置/插件顺序（底部 48px + whiskermenu + tasklist + 托盘 + 时钟）
#   缺它则 xfce4-panel 首启用 hardcoded 默认值（顶部 panel + 老 applicationsmenu），
#   表现为"开始菜单在最顶上 + 桌面细节不对齐"——这是登录后视觉割裂的根因。
COPY docker/xfce-xsettings.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
COPY docker/xfce-xfwm4.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
COPY docker/xfce-desktop.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
COPY docker/xfce4-panel.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
# Fluent 壁纸（明/暗），xfdesktop 通过 librsvg 直接渲染 SVG
COPY docker/desktop-fluent-wallpaper.svg /usr/share/backgrounds/fluent/fluent-wallpaper.svg
COPY docker/desktop-fluent-wallpaper-dark.svg /usr/share/backgrounds/fluent/fluent-wallpaper-dark.svg
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh /usr/local/bin/init-warp.sh /usr/local/bin/init-desktop.sh /etc/xrdp/startwm.sh \
    && chmod 755 /usr/local/share/opencode-desktop-launchers/opencode-*.desktop /usr/share/applications/opencode-*.desktop

WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
